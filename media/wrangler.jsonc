{
  "name": "lopecode-media",
  "main": "src/worker.ts",
  "compatibility_date": "2025-12-25",
  "observability": { "enabled": true }
  // Reached via service binding from the apex `lopecode` Worker
  // (images.lopecode.com → IMAGES). No routes / Custom Domains — apex's
  // wildcard *.lopecode.com claims the host and forwards by SIBLING_HOSTS.
  //
  // No service bindings: everything this Worker needs (the DID document,
  // the record, the bytes) comes from the open network — plc.directory or
  // the did:web host, then the author's own PDS.
}
